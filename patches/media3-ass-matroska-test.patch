+  private static final class HookMatroskaExtractor extends MatroskaExtractor {
+    public final List<Integer> trackNumbers;
+    public final List<Integer> sampleTrackNumbers;
+    public final List<byte[]> samples;
+    public final List<Long> sampleDurationsUs;
+    @Nullable public byte[] codecPrivate;
+    @Nullable public String attachmentName;
+    @Nullable public String attachmentMimeType;
+    @Nullable public byte[] attachmentData;
+
+    public HookMatroskaExtractor() {
+      super(SubtitleParser.Factory.UNSUPPORTED, FLAG_EMIT_RAW_SUBTITLE_DATA);
+      trackNumbers = new ArrayList<>();
+      sampleTrackNumbers = new ArrayList<>();
+      samples = new ArrayList<>();
+      sampleDurationsUs = new ArrayList<>();
+    }
+
+    @Override
+    protected boolean shouldReadAttachment(
+        @Nullable String fileName, @Nullable String mimeType, int contentSize) {
+      return contentSize <= 1024;
+    }
+
+    @Override
+    protected void onAttachment(
+        @Nullable String fileName, @Nullable String mimeType, byte[] attachmentData) {
+      attachmentName = fileName;
+      attachmentMimeType = mimeType;
+      this.attachmentData = attachmentData;
+    }
+
+    @Override
+    protected void onAssTrackInitialized(
+        int trackNumber,
+        @Nullable String name,
+        @Nullable String language,
+        byte[] codecPrivate) {
+      trackNumbers.add(trackNumber);
+      this.codecPrivate = Arrays.copyOf(codecPrivate, codecPrivate.length);
+    }
+
+    @Override
+    protected void onAssSubtitleSample(
+        int trackNumber,
+        long timeUs,
+        long durationUs,
+        byte[] sampleData,
+        int sampleOffset,
+        int sampleLength) {
+      sampleTrackNumbers.add(trackNumber);
+      samples.add(Arrays.copyOfRange(sampleData, sampleOffset, sampleOffset + sampleLength));
+      sampleDurationsUs.add(durationUs);
+    }
+  }
 }
