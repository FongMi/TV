+  @Test
+  public void assHooks_receiveCodecPrivateAndOriginalMatroskaSamples() throws Exception {
+    byte[] fileBytes =
+        TestUtil.getByteArray(
+            ApplicationProvider.getApplicationContext(),
+            "media/mkv/sample_with_ass_subtitles.mkv");
+    HookMatroskaExtractor extractor = new HookMatroskaExtractor();
+    extractor.init(new FakeExtractorOutput());
+    FakeExtractorInput input = new FakeExtractorInput.Builder().setData(fileBytes).build();
+    PositionHolder positionHolder = new PositionHolder();
+
+    int result;
+    do {
+      result = extractor.read(input, positionHolder);
+      if (result == RESULT_SEEK) {
+        input.setPosition((int) positionHolder.position);
+      }
+    } while (result != RESULT_END_OF_INPUT);
+
+    assertThat(new String(checkNotNull(extractor.codecPrivate), StandardCharsets.UTF_8))
+        .contains("[Script Info]");
+    assertThat(extractor.trackNumbers).hasSize(1);
+    assertThat(extractor.sampleTrackNumbers).isNotEmpty();
+    for (int trackNumber : extractor.sampleTrackNumbers) {
+      assertThat(trackNumber).isEqualTo(extractor.trackNumbers.get(0));
+    }
+    assertThat(extractor.samples).isNotEmpty();
+    assertThat(new String(extractor.samples.get(0), StandardCharsets.UTF_8)).doesNotContain("Dialogue:");
+    assertThat(extractor.sampleDurationsUs.get(0)).isGreaterThan(0);
+  }
