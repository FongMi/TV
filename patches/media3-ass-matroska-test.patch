+        fontData.length,
+        new FakeExtractorInput.Builder().setData(fontData).build());
+    extractor.endMasterElement(ID_ATTACHED_FILE);
+
+    assertThat(extractor.attachmentName).isEqualTo("subtitle.ttf");
+    assertThat(extractor.attachmentMimeType).isEqualTo("font/ttf");
+    assertThat(extractor.attachmentData).isEqualTo(fontData);
