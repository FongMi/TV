diff --git a/libraries/mpvplayer/src/main/java/androidx/media3/mpvplayer/nativebridge/MpvCommandDispatcher.java b/libraries/mpvplayer/src/main/java/androidx/media3/mpvplayer/nativebridge/MpvCommandDispatcher.java
index bbf8ce6..8d71113 100644
--- a/libraries/mpvplayer/src/main/java/androidx/media3/mpvplayer/nativebridge/MpvCommandDispatcher.java
+++ b/libraries/mpvplayer/src/main/java/androidx/media3/mpvplayer/nativebridge/MpvCommandDispatcher.java
@@ -137,6 +137,46 @@ public final class MpvCommandDispatcher {
     return client.command(new String[] {CMD_SCRIPT_BINDING, STATS_GENERAL_PAGE_TOGGLE});
   }
 
+  /** Sends a DVD/Blu-ray menu command to mpv's native disc navigation backend. */
+  public boolean sendDiscNavigation(String action) {
+    if (action == null) {
+      return false;
+    }
+    switch (action) {
+      case "up":
+      case "down":
+      case "left":
+      case "right":
+      case "select":
+      case "menu":
+      case "title-menu":
+      case "popup":
+      case "prev":
+        return client.command(new String[] {"discnav", action});
+      default:
+        return false;
+    }
+  }
+
+  /** Sends a pointer event inside the video viewport, with coordinates in the range [0, 1). */
+  public boolean sendDiscPointer(float x, float y, boolean activate) {
+    if (!Float.isFinite(x) || !Float.isFinite(y) || x < 0 || x > 1 || y < 0 || y > 1) {
+      return false;
+    }
+    return client.command(
+        new String[] {
+          "discnav",
+          activate ? "mouse-click" : "mouse-move",
+          Float.toString(Math.min(x, Math.nextDown(1.0f))),
+          Float.toString(Math.min(y, Math.nextDown(1.0f)))
+        });
+  }
+
+  /** Null means the currently loaded source is not an optical-disc navigation stream. */
+  public Boolean getDiscMenuActive() {
+    return client.getPropertyBoolean("disc-menu-active");
+  }
+
   public boolean addSubtitle(MediaItem.SubtitleConfiguration subtitle, boolean select) {
     return client.command(getAddSubtitleCommand(subtitle, select));
   }
diff --git a/libraries/mpvplayer/src/test/java/androidx/media3/mpvplayer/nativebridge/MpvCommandDispatcherTest.java b/libraries/mpvplayer/src/test/java/androidx/media3/mpvplayer/nativebridge/MpvCommandDispatcherTest.java
