+package androidx.media3.decoder.ffmpeg;
+
+import static com.google.common.truth.Truth.assertThat;
+
+import androidx.media3.common.Format;
+import androidx.media3.common.MimeTypes;
+import androidx.media3.common.util.CodecSpecificDataUtil;
+import androidx.test.ext.junit.runners.AndroidJUnit4;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+/** Guards the software RPU mapping policy used by non-backward-compatible Dolby Vision P5. */
+@RunWith(AndroidJUnit4.class)
+public final class FfmpegDolbyVisionOutputTest {
+
+  @Test
+  public void profile5WithRpu_requiresGpuMapping() {
+    Format format = profile5WithConfiguration(true);
+
+    assertThat(FfmpegLibrary.getDolbyVisionOutputMode(format))
+        .isEqualTo(FfmpegLibrary.DOLBY_VISION_OUTPUT_MODE_REQUIRE_MAPPING);
+  }
+
+  @Test
+  public void profile5WithoutRpu_doesNotDisplayUnmappedBaseLayer() {
+    Format format = profile5WithConfiguration(false);
+
+    assertThat(FfmpegLibrary.getDolbyVisionOutputMode(format))
+        .isEqualTo(FfmpegLibrary.DOLBY_VISION_OUTPUT_MODE_NONE);
+  }
+
+  private static Format profile5WithConfiguration(boolean rpuPresent) {
+    byte[] config = CodecSpecificDataUtil.buildDolbyVisionInitializationData(5, 1);
+    if (!rpuPresent) {
+      config[3] &= ~0x04;
+    }
+    return new Format.Builder()
+        .setSampleMimeType(MimeTypes.VIDEO_DOLBY_VISION)
+        .setCodecs("dvhe.05.01")
+        .setInitializationData(CodecSpecificDataUtil.setDolbyVisionCsd(null, config))
+        .build();
+  }
+}
