+++ b/libraries/mpvplayer/src/test/java/androidx/media3/mpvplayer/nativebridge/MpvCommandDispatcherTest.java
@@ -57,4 +57,41 @@ public final class MpvCommandDispatcherTest {
     verify(client).command(aryEq(command));
     verifyNoMoreInteractions(client);
   }
+
+  @Test
+  public void sendDiscNavigation_queuesNativeMenuCommand() {
+    MpvClient client = mock(MpvClient.class);
+    MpvCommandDispatcher dispatcher = new MpvCommandDispatcher(client);
+    String[] command = {"discnav", "menu"};
+    when(client.command(aryEq(command))).thenReturn(true);
+
+    assertThat(dispatcher.sendDiscNavigation("menu")).isTrue();
+
+    verify(client).command(aryEq(command));
+    verifyNoMoreInteractions(client);
+  }
+
+  @Test
+  public void sendDiscNavigation_rejectsUnrecognizedCommand() {
+    MpvClient client = mock(MpvClient.class);
+    MpvCommandDispatcher dispatcher = new MpvCommandDispatcher(client);
+
+    assertThat(dispatcher.sendDiscNavigation("loadfile")).isFalse();
+
+    verifyNoMoreInteractions(client);
+  }
+
+  @Test
+  public void sendDiscPointer_usesNormalizedCoordinates() {
+    MpvClient client = mock(MpvClient.class);
+    MpvCommandDispatcher dispatcher = new MpvCommandDispatcher(client);
+    String[] command = {"discnav", "mouse-click", "0.25", "0.75"};
+    when(client.command(aryEq(command))).thenReturn(true);
+
+    assertThat(dispatcher.sendDiscPointer(0.25f, 0.75f, true)).isTrue();
+    assertThat(dispatcher.sendDiscPointer(Float.NaN, 0.5f, true)).isFalse();
+
+    verify(client).command(aryEq(command));
+    verifyNoMoreInteractions(client);
+  }
 }
