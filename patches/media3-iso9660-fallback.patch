@@ -0,0 +1,141 @@
+package androidx.media3.extractor.iso.udf;
+
+import static com.google.common.truth.Truth.assertThat;
+import static org.junit.Assert.assertThrows;
+
+import androidx.media3.common.CacheDataReader;
+import androidx.media3.extractor.iso.IsoFileEntry;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.util.Arrays;
+import org.junit.Test;
+
+/** Tests a DVD-style ISO 9660 image without a UDF anchor or file set descriptor. */
+public final class Iso9660FallbackTest {
+
+  private static final int BLOCK = 2048;
+
+  @Test
+  public void iso9660OnlyDisc_findFileAndListFiles() throws Exception {
+    byte[] image = createDisc();
+    UdfFileSystem fileSystem = new UdfFileSystem();
+    fileSystem.open(reader(image));
+
+    IsoFileEntry file = fileSystem.findFile("video_ts\\VIDEO_TS.IFO");
+    assertThat(file).isNotNull();
+    assertThat(file.name).isEqualTo("VIDEO_TS.IFO");
+    assertThat(file.byteOffset).isEqualTo(22L * BLOCK);
+    assertThat(file.length).isEqualTo(5);
+    assertThat(fileSystem.findFile("VIDEO_TS")).isNull();
+    assertThat(fileSystem.findFile("VIDEO_TS/MISSING.IFO")).isNull();
+    assertThat(fileSystem.listFiles("/VIDEO_TS")).containsExactly("VIDEO_TS.IFO");
+    assertThat(fileSystem.listFiles("/MISSING")).isEmpty();
+  }
+
+  @Test
+  public void bootRecordBeforePrimaryVolumeDescriptor_findsDvdFiles() throws Exception {
+    byte[] image = createDisc();
+    System.arraycopy(image, 16 * BLOCK, image, 17 * BLOCK, BLOCK);
+    Arrays.fill(image, 16 * BLOCK, 17 * BLOCK, (byte) 0);
+    System.arraycopy("CD001".getBytes(StandardCharsets.US_ASCII), 0, image, 16 * BLOCK + 1, 5);
+    image[16 * BLOCK + 6] = 1;
+    UdfFileSystem fileSystem = new UdfFileSystem();
+    fileSystem.open(reader(image));
+
+    assertThat(fileSystem.findFile("VIDEO_TS/VIDEO_TS.IFO")).isNotNull();
+  }
+
+  @Test
+  public void malformedDirectoryRecord_rejectsInsteadOfReadingPastRecord() throws Exception {
+    byte[] image = createDisc();
+    // Two special records (34 bytes each) and VIDEO_TS (42 bytes) precede this record.
+    image[20 * BLOCK + 110] = 2;
+    UdfFileSystem fileSystem = new UdfFileSystem();
+    fileSystem.open(reader(image));
+
+    assertThrows(IOException.class, () -> fileSystem.listFiles("/"));
+  }
+
+  @Test
+  public void unknownImage_doesNotClaimIso9660Support() {
+    byte[] image = new byte[40 * BLOCK];
+    assertThrows(IOException.class, () -> new UdfFileSystem().open(reader(image)));
+  }
+
+  @Test
+  public void multiExtentFile_rejectsPartialPlayback() throws Exception {
+    byte[] image = createDisc();
+    // Two special records (34 bytes each) precede VIDEO_TS.IFO in the child directory.
+    image[21 * BLOCK + 68 + 25] = (byte) 0x80;
+    UdfFileSystem fileSystem = new UdfFileSystem();
+    fileSystem.open(reader(image));
+
+    assertThrows(IOException.class, () -> fileSystem.findFile("VIDEO_TS/VIDEO_TS.IFO"));
+  }
+
+  private static byte[] createDisc() {
+    byte[] image = new byte[40 * BLOCK];
+    int pvd = 16 * BLOCK;
+    image[pvd] = 1;
+    System.arraycopy("CD001".getBytes(StandardCharsets.US_ASCII), 0, image, pvd + 1, 5);
+    image[pvd + 6] = 1;
+    put16(image, pvd + 128, BLOCK);
+    image[pvd + 130] = (byte) (BLOCK >>> 8);
+    image[pvd + 131] = (byte) BLOCK;
+    writeRecord(image, pvd + 156, 20, BLOCK, true, new byte[] {0});
+
+    int root = 20 * BLOCK;
+    int position = writeRecord(image, root, 20, BLOCK, true, new byte[] {0});
+    position = writeRecord(image, position, 20, BLOCK, true, new byte[] {1});
+    writeRecord(image, position, 21, BLOCK, true, "VIDEO_TS".getBytes(StandardCharsets.US_ASCII));
+
+    int videoTs = 21 * BLOCK;
+    position = writeRecord(image, videoTs, 21, BLOCK, true, new byte[] {0});
+    position = writeRecord(image, position, 20, BLOCK, true, new byte[] {1});
+    writeRecord(image, position, 22, 5, false, "VIDEO_TS.IFO;1".getBytes(StandardCharsets.US_ASCII));
+    System.arraycopy(new byte[] {1, 2, 3, 4, 5}, 0, image, 22 * BLOCK, 5);
+    return image;
+  }
+
+  private static int writeRecord(
+      byte[] image, int offset, int extent, int length, boolean directory, byte[] name) {
+    int recordLength = 33 + name.length + (name.length % 2 == 0 ? 1 : 0);
+    image[offset] = (byte) recordLength;
+    put32(image, offset + 2, extent);
+    put32(image, offset + 10, length);
+    image[offset + 25] = (byte) (directory ? 2 : 0);
+    image[offset + 32] = (byte) name.length;
+    System.arraycopy(name, 0, image, offset + 33, name.length);
+    return offset + recordLength;
+  }
+
+  private static void put16(byte[] image, int offset, int value) {
+    image[offset] = (byte) value;
+    image[offset + 1] = (byte) (value >>> 8);
+  }
+
+  private static void put32(byte[] image, int offset, int value) {
+    for (int i = 0; i < 4; i++) {
+      image[offset + i] = (byte) (value >>> (i * 8));
+    }
+  }
+
+  private static CacheDataReader reader(byte[] image) {
+    return new CacheDataReader() {
+      @Override
+      public int read(long byteOffset, byte[] buffer, int offset, int length) {
+        if (byteOffset < 0 || byteOffset >= image.length) {
+          return -1;
+        }
+        int read = Math.min(Math.min(length, 217), image.length - (int) byteOffset);
+        System.arraycopy(image, (int) byteOffset, buffer, offset, read);
+        return read;
+      }
+
+      @Override
+      public long length() {
+        return image.length;
+      }
+    };
+  }
+}
