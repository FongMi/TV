+package androidx.media3.extractor.iso.udf;
+
+import androidx.annotation.Nullable;
+import androidx.media3.common.CacheDataReader;
+import androidx.media3.extractor.iso.IsoConstants;
+import androidx.media3.extractor.iso.IsoFileEntry;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+
+/** Reads the primary ISO 9660 directory tree when a disc image has no UDF file set. */
+final class Iso9660FileSystem {
+
+  private static final int BLOCK_SIZE = IsoConstants.SECTOR_SIZE;
+  private static final int PRIMARY_VOLUME_SECTOR = 16;
+  private static final int MAX_VOLUME_DESCRIPTORS = 32;
+  private static final int ROOT_RECORD_OFFSET = 156;
+  private static final int MIN_RECORD_LENGTH = 34;
+  private static final int MAX_DIRECTORY_BYTES = 8 * 1024 * 1024;
+
+  private final CacheDataReader reader;
+  private final Entry root;
+
+  private Iso9660FileSystem(CacheDataReader reader, Entry root) {
+    this.reader = reader;
+    this.root = root;
+  }
+
+  public static Iso9660FileSystem open(CacheDataReader reader) throws IOException {
+    for (int sectorNumber = PRIMARY_VOLUME_SECTOR;
+        sectorNumber < PRIMARY_VOLUME_SECTOR + MAX_VOLUME_DESCRIPTORS;
+        sectorNumber++) {
+      byte[] sector = readSector(reader, sectorNumber);
+      if (sector[1] != 'C'
+          || sector[2] != 'D'
+          || sector[3] != '0'
+          || sector[4] != '0'
+          || sector[5] != '1'
+          || sector[6] != 1) {
+        throw new IOException("ISO 9660: invalid volume descriptor");
+      }
+      if (sector[0] == (byte) 255) {
+        break;
+      }
+      if (sector[0] == 1) {
+        if (unsigned16(sector, 128) != BLOCK_SIZE) {
+          throw new IOException("ISO 9660: unsupported logical block size");
+        }
+        int rootLength = sector[ROOT_RECORD_OFFSET] & 0xFF;
+        Entry root = readRecord(sector, ROOT_RECORD_OFFSET, rootLength);
+        if (!root.directory) {
+          throw new IOException("ISO 9660: root directory is missing");
+        }
+        return new Iso9660FileSystem(reader, root);
+      }
+    }
+    throw new IOException("ISO 9660: primary volume descriptor not found");
+  }
+
+  @Nullable
+  public IsoFileEntry findFile(String path) throws IOException {
+    Entry entry = resolve(path);
+    if (entry == null || entry.directory) {
+      return null;
+    }
+    if (entry.continuesInNextRecord) {
+      throw new IOException("ISO 9660: multi-extent files are not supported: " + entry.name);
+    }
+    long byteOffset = entry.sector * BLOCK_SIZE;
+    long imageLength = reader.length();
+    if (imageLength >= 0 && (byteOffset > imageLength || entry.length > imageLength - byteOffset)) {
+      throw new IOException("ISO 9660: file extent is outside the image");
+    }
+    return new IsoFileEntry(entry.name, byteOffset, entry.length);
+  }
+
+  public List<String> listFiles(String path) throws IOException {
+    Entry entry = resolve(path);
+    List<String> names = new ArrayList<>();
+    if (entry != null && entry.directory) {
+      for (Entry child : readDirectory(entry)) {
+        names.add(child.name);
+      }
+    }
+    return names;
+  }
+
+  @Nullable
+  private Entry resolve(@Nullable String path) throws IOException {
+    Entry current = root;
+    if (path == null || path.isEmpty() || path.equals("/")) {
+      return current;
+    }
+    for (String part : path.replace('\\', '/').split("/")) {
+      if (part.isEmpty() || part.equals(".")) {
+        continue;
+      }
+      if (part.equals("..") || !current.directory) {
+        return null;
+      }
+      Entry next = null;
+      for (Entry child : readDirectory(current)) {
+        if (child.name.equalsIgnoreCase(part)) {
+          next = child;
+          break;
+        }
+      }
+      if (next == null) {
+        return null;
+      }
+      current = next;
+    }
+    return current;
+  }
+
+  private List<Entry> readDirectory(Entry directory) throws IOException {
+    if (directory.length < 0 || directory.length > MAX_DIRECTORY_BYTES) {
+      throw new IOException("ISO 9660: directory exceeds size limit");
+    }
+    List<Entry> children = new ArrayList<>();
+    for (long bytePosition = 0; bytePosition < directory.length; bytePosition += BLOCK_SIZE) {
+      long sectorNumber = directory.sector + bytePosition / BLOCK_SIZE;
+      byte[] sector = readSector(reader, sectorNumber);
+      int limit = (int) Math.min(BLOCK_SIZE, directory.length - bytePosition);
+      int offset = 0;
+      while (offset < limit) {
+        int length = sector[offset] & 0xFF;
+        if (length == 0) {
+          break;
+        }
+        if (length < MIN_RECORD_LENGTH || length > limit - offset) {
+          throw new IOException("ISO 9660: malformed directory record");
+        }
+        Entry entry = readRecord(sector, offset, length);
+        if (entry.directory && entry.continuesInNextRecord) {
+          throw new IOException("ISO 9660: multi-extent directories are not supported");
+        }
+        if (!entry.name.equals("/") && !entry.name.equals("..")) {
+          children.add(entry);
+        }
+        offset += length;
+      }
+    }
+    return children;
+  }
+
+  private static Entry readRecord(byte[] sector, int offset, int length) throws IOException {
+    if (length < MIN_RECORD_LENGTH || offset < 0 || offset > sector.length - length) {
+      throw new IOException("ISO 9660: invalid directory record length");
+    }
+    if (sector[offset + 1] != 0) {
+      throw new IOException("ISO 9660: extended attribute records are not supported");
+    }
+    int nameLength = sector[offset + 32] & 0xFF;
+    if (nameLength == 0 || nameLength > length - 33) {
+      throw new IOException("ISO 9660: invalid file identifier length");
+    }
+    if (nameLength == 1 && (sector[offset + 33] == 0 || sector[offset + 33] == 1)) {
+      String specialName = sector[offset + 33] == 0 ? "/" : "..";
+      return new Entry(
+          specialName,
+          unsigned32(sector, offset + 2),
+          unsigned32(sector, offset + 10),
+          (sector[offset + 25] & 2) != 0,
+          false);
+    }
+    String name = new String(sector, offset + 33, nameLength, StandardCharsets.US_ASCII);
+    int version = name.lastIndexOf(';');
+    if (version >= 0 && version + 1 < name.length()) {
+      String suffix = name.substring(version + 1);
+      if (suffix.chars().allMatch(Character::isDigit)) {
+        name = name.substring(0, version);
+      }
+    }
+    if (name.endsWith(".")) {
+      name = name.substring(0, name.length() - 1);
+    }
+    if (name.isEmpty()) {
+      throw new IOException("ISO 9660: empty file identifier");
+    }
+    return new Entry(
+        name,
+        unsigned32(sector, offset + 2),
+        unsigned32(sector, offset + 10),
+        (sector[offset + 25] & 2) != 0,
+        (sector[offset + 25] & 0x80) != 0);
+  }
+
+  private static byte[] readSector(CacheDataReader reader, long sectorNumber) throws IOException {
+    byte[] sector = new byte[BLOCK_SIZE];
+    long byteOffset;
+    try {
+      byteOffset = Math.multiplyExact(sectorNumber, BLOCK_SIZE);
+    } catch (ArithmeticException e) {
+      throw new IOException("ISO 9660: sector offset overflow", e);
+    }
+    for (int offset = 0; offset < BLOCK_SIZE; ) {
+      int count = reader.read(byteOffset + offset, sector, offset, BLOCK_SIZE - offset);
+      if (count <= 0) {
+        throw new IOException("ISO 9660: truncated sector " + sectorNumber);
+      }
+      offset += count;
+    }
+    return sector;
+  }
+
+  private static int unsigned16(byte[] data, int offset) {
+    return (data[offset] & 0xFF) | ((data[offset + 1] & 0xFF) << 8);
+  }
+
+  private static long unsigned32(byte[] data, int offset) {
+    return (data[offset] & 0xFFL)
+        | ((data[offset + 1] & 0xFFL) << 8)
+        | ((data[offset + 2] & 0xFFL) << 16)
+        | ((data[offset + 3] & 0xFFL) << 24);
+  }
+
+  private static final class Entry {
+    public final String name;
+    public final long sector;
+    public final long length;
+    public final boolean directory;
+    public final boolean continuesInNextRecord;
+
+    private Entry(
+        String name, long sector, long length, boolean directory, boolean continuesInNextRecord) {
+      this.name = name;
+      this.sector = sector;
+      this.length = length;
+      this.directory = directory;
+      this.continuesInNextRecord = continuesInNextRecord;
+    }
+  }
+}
