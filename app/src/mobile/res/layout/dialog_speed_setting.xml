<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/speed_setting"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reset"
            style="@style/PlaybackDialogAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:nextFocusDown="@id/slider"
            android:text="@string/speed_setting_reset"
            android:textColor="?attr/colorPrimary" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <include
                android:id="@+id/speed"
                layout="@layout/view_setting_slider" />

            <include
                android:id="@+id/longPressSpeed"
                layout="@layout/view_setting_slider" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="24dp"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"
                android:text="@string/speed_setting_quick"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/presetGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                app:alignItems="center"
                app:flexWrap="wrap">

                <com.google.android.material.chip.Chip
                    android:id="@+id/preset01"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:checkable="false"
                    android:fontFeatureSettings="tnum"
                    android:text="@string/speed_value_05"
                    android:textAlignment="center"
                    app:layout_flexGrow="1"
                    app:layout_flexShrink="0" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/preset02"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:checkable="false"
                    android:fontFeatureSettings="tnum"
                    android:text="@string/speed_value_08"
                    android:textAlignment="center"
                    app:layout_flexGrow="1"
                    app:layout_flexShrink="0" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/preset03"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:checkable="false"
                    android:fontFeatureSettings="tnum"
                    android:text="@string/speed_value_10"
                    android:textAlignment="center"
                    app:layout_flexGrow="1"
                    app:layout_flexShrink="0" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/preset04"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:checkable="false"
                    android:fontFeatureSettings="tnum"
                    android:text="@string/speed_value_12"
                    android:textAlignment="center"
                    app:layout_flexGrow="1"
                    app:layout_flexShrink="0" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/preset05"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:checkable="false"
                    android:fontFeatureSettings="tnum"
                    android:text="@string/speed_value_15"
                    android:textAlignment="center"
                    app:layout_flexGrow="1"
                    app:layout_flexShrink="0" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/preset06"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:checkable="false"
                    android:fontFeatureSettings="tnum"
                    android:text="@string/speed_value_20"
                    android:textAlignment="center"
                    app:layout_flexGrow="1"
                    app:layout_flexShrink="0" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/preset07"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:checkable="false"
                    android:fontFeatureSettings="tnum"
                    android:text="@string/speed_value_30"
                    android:textAlignment="center"
                    app:layout_flexGrow="1"
                    app:layout_flexShrink="0" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/preset08"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:checkable="false"
                    android:fontFeatureSettings="tnum"
                    android:text="@string/speed_value_50"
                    android:textAlignment="center"
                    app:layout_flexGrow="1"
                    app:layout_flexShrink="0" />

            </com.google.android.flexbox.FlexboxLayout>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/skipSilenceRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:paddingVertical="12dp">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/speed_setting_skip_silence"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <FrameLayout style="@style/PlaybackDialogSwitchContainer">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/skipSilenceSwitch"
                        style="@style/PlaybackDialogSwitch" />

                </FrameLayout>

            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>
