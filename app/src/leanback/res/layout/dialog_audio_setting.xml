<?xml version="1.0" encoding="utf-8"?>
<com.fongmi.android.tv.ui.custom.CustomTabLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.LinearLayoutCompat
        style="@style/PlaybackDialogHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.textview.MaterialTextView
            style="@style/PlaybackDialogTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/audio_setting" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/compare"
            style="@style/PlaybackDialogAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/playback_dialog_spacing"
            android:text="@string/audio_effect_compare" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reset"
            style="@style/PlaybackDialogAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/audio_effect_reset" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/tabGroup"
        style="@style/PlaybackDialogTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabPreset"
            style="@style/PlaybackDialogTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/audio_effect_tab_preset" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabEqualizer"
            style="@style/PlaybackDialogTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/audio_effect_tab_equalizer" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabOffset"
            style="@style/PlaybackDialogTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/setting_tab_offset" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabAdvanced"
            style="@style/PlaybackDialogTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/audio_effect_tab_advanced" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/unsupported"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/playback_dialog_inset"
        android:layout_marginTop="@dimen/playback_dialog_spacing"
        android:layout_marginEnd="@dimen/playback_dialog_inset"
        android:layout_marginBottom="@dimen/playback_dialog_tab_content_spacing"
        android:text="@string/error_audio_effect_unsupported"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorError"
        android:visibility="gone" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <androidx.appcompat.widget.LinearLayoutCompat
            style="@style/PlaybackDialogBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/presetSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="24dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="4dp"
                    android:text="@string/setting_effect_basic"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/presetBasicGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="24dp"
                    app:chipSpacingVertical="0dp"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/presetOriginal"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_preset_original" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/presetNatural"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/audio_effect_natural" />

                </com.google.android.material.chip.ChipGroup>

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="24dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="4dp"
                    android:text="@string/audio_effect_category_tone"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/presetToneGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="24dp"
                    app:chipSpacingVertical="0dp"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/presetVocal"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/audio_effect_vocal" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/presetCinema"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/audio_effect_cinema" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/presetBass"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/audio_effect_bass" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/presetTreble"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/audio_effect_treble" />

                </com.google.android.material.chip.ChipGroup>

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="24dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="4dp"
                    android:text="@string/audio_effect_category_genre"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/presetGenreGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="24dp"
                    app:chipSpacingVertical="0dp"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/presetPop"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/audio_effect_pop" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/presetRock"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/audio_effect_rock" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/presetDance"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/audio_effect_dance" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/presetElectronic"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/audio_effect_electronic" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/presetHipHop"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/audio_effect_hiphop" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/presetJazz"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/audio_effect_jazz" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/presetClassical"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/audio_effect_classical" />

                </com.google.android.material.chip.ChipGroup>

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="24dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="4dp"
                    android:text="@string/setting_effect_custom"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/presetCustomGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="24dp"
                    app:chipSpacingVertical="0dp"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/presetCustom"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/audio_effect_custom" />

                </com.google.android.material.chip.ChipGroup>

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/equalizerSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/bands"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/offsetSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <include
                    android:id="@+id/offset"
                    layout="@layout/view_setting_slider" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/advancedSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/audioSettingOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="24dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:orientation="vertical"
                            android:paddingStart="0dp"
                            android:paddingEnd="64dp">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/audio_effect_loudness"
                                android:textAppearance="?attr/textAppearanceBodyLarge" />

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:alpha="0.7"
                                android:text="@string/audio_effect_loudness_summary"
                                android:textAppearance="?attr/textAppearanceBodySmall" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                        <FrameLayout
                            style="@style/PlaybackDialogSwitchContainer"
                            android:layout_gravity="end|center_vertical">

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/loudness"
                                style="@style/PlaybackDialogSwitch"
                                android:contentDescription="@string/audio_effect_loudness" />

                        </FrameLayout>

                    </FrameLayout>

                    <include
                        android:id="@+id/stability"
                        layout="@layout/view_setting_slider" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.7"
                        android:paddingHorizontal="24dp"
                        android:paddingBottom="4dp"
                        android:text="@string/audio_effect_stability_summary"
                        android:textAppearance="?attr/textAppearanceBodySmall" />

                    <include
                        android:id="@+id/dialogue"
                        layout="@layout/view_setting_slider" />

                    <include
                        android:id="@+id/boost"
                        layout="@layout/view_setting_slider" />

                    <include
                        android:id="@+id/preamp"
                        layout="@layout/view_setting_slider" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/channelSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="24dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="4dp"
                            android:text="@string/audio_channel_mode"
                            android:textAppearance="?attr/textAppearanceBodyLarge" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/channelModeGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="24dp"
                            app:chipSpacingVertical="0dp"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/channelAuto"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/audio_channel_auto" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/channelStereo"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/audio_channel_stereo" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/channelMono"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/audio_channel_mono" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/channelReverse"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/audio_channel_reverse" />

                        </com.google.android.material.chip.ChipGroup>

                        <include
                            android:id="@+id/centerGain"
                            layout="@layout/view_setting_slider" />

                        <include
                            android:id="@+id/balance"
                            layout="@layout/view_setting_slider" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>
</com.fongmi.android.tv.ui.custom.CustomTabLayout>
