<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/ic_splash_logo">

    <target android:name="logo_motion">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <set android:ordering="together">
                    <objectAnimator
                        android:duration="576"
                        android:interpolator="@android:interpolator/fast_out_slow_in"
                        android:propertyName="scaleX"
                        android:valueFrom="0.72"
                        android:valueTo="1.02"
                        android:valueType="floatType" />
                    <objectAnimator
                        android:duration="576"
                        android:interpolator="@android:interpolator/fast_out_slow_in"
                        android:propertyName="scaleY"
                        android:valueFrom="0.72"
                        android:valueTo="1.02"
                        android:valueType="floatType" />
                    <objectAnimator
                        android:duration="576"
                        android:interpolator="@android:interpolator/fast_out_slow_in"
                        android:propertyName="rotation"
                        android:valueFrom="-8"
                        android:valueTo="0"
                        android:valueType="floatType" />
                </set>
                <set android:ordering="together">
                    <objectAnimator
                        android:duration="224"
                        android:interpolator="@android:interpolator/fast_out_slow_in"
                        android:propertyName="scaleX"
                        android:valueFrom="1.02"
                        android:valueTo="1"
                        android:valueType="floatType" />
                    <objectAnimator
                        android:duration="224"
                        android:interpolator="@android:interpolator/fast_out_slow_in"
                        android:propertyName="scaleY"
                        android:valueFrom="1.02"
                        android:valueTo="1"
                        android:valueType="floatType" />
                </set>
            </set>
        </aapt:attr>
    </target>
    <target android:name="logo_top_motion">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="576"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="translateY"
                android:startOffset="0"
                android:valueFrom="-92"
                android:valueTo="0"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="logo_left_motion">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="576"
